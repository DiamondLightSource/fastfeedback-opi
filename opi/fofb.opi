  <widget typeId="org.csstudio.opibuilder.widgets.ActionButton">
    <actions>
      <action type="EXECUTE_CMD">
        <wait_time>10</wait_time>
        <command_directory>$(opi.dir)</command_directory>
        <command>./run-command 'Start FOFB' ./fofbnogui.py start</command>
        <description></description>
      </action>
    </actions>
    <background_color>
      <color red="200" green="200" blue="200" name="Canvas"/>
    </background_color>
    <font>
      <opifont.name fontName="Liberation Sans" height="15" style="0" pixels="true">Label Small</opifont.name>
    </font>
    <foreground_color>
      <color red="0" green="0" blue="255" name="Blue"/>
    </foreground_color>
    <height>24</height>
    <text>Start</text>
    <width>90</width>
    <x>100</x>
    <y>145</y>
  </widget>
