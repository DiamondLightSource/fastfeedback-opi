# Global configuration for FOFB for all SR ring modes.


CELLS      = 24
MAGS       = 7
MAX_TAPS   = 9
BPMS       = 173

# eta x and eta y lower number is higher bandwidth
ETAX = 1.0
ETAY = 1.0

# While running with only one cavity we need to turn the horizontal fast
# feedback response down, rather hard, to avoid exciting the lower synchrotron
# exciations.
# ETAX = 5.0


# Comment GR 11/01/15: WEIGHTS don't work like that any more. See fofbnogui.py
#
# # The bandwidths below work quite nicely for weighting 
# # [1 0.2 0.05 0.05 0.05 0.2 1]
# ETAX = 0.5
# ETAY = 0.8
WEIGHTS = None

# interlock limits
MAX_BPMS = 176   # Vectorized computation requires multiple of four
CORRECTOR_LIMIT = 1         # in A
TRACK_RATE = 2 * 2 * pi
BPMS_OUTSIDE_ORBIT_LIMIT = 0

ALL_CELL_BPMS = range(0, BPMS) + range(MAX_BPMS, MAX_BPMS + BPMS)
CELL_2_BPMS = range(7, 15) + range(MAX_BPMS + 7, MAX_BPMS + 15)

# Orbit trip limit in nm
ORBIT_LIMIT = zeros(MAX_BPMS*2)  # [X BPMS, padding, Y BPMS, padding]
ORBIT_LIMIT[ALL_CELL_BPMS] = 0.250e6
ORBIT_LIMIT[CELL_2_BPMS] = 0.125e6  # Reduced aperture in cell 2

# regularization parameter
MU = array((1.0, 1.0))
EPSILON = 1e-6

DELAY = 7                   # in cycles
Ts = 100e-6                 # cycle time in seconds

DATAROOT = '/dls_sw/work/common/matlab/mml/machine/diamondopsdata'
# Should be
# DATAROOT = '/dls_sw/work/common/matlab/mml/machine-new/diamondopsdata'

# what is the bandwidth of the system?
CUTOFF = [500 * 2 * pi, 700 * 2 * pi]


# Mode specific overrides below here.

if mode == 'DIADSP':
    ETAX = 2.0
    ETAY = 2.0
    MU = array((1.0, 1.0))
    ORBIT_LIMIT[ALL_CELL_BPMS] = 0.500e6

elif mode == 'DIADTHz':
    ETAX = 2.0
    ETAY = 2.0
    MU = array((2.0, 2.0))
    ORBIT_LIMIT[ALL_CELL_BPMS] = 0.500e6

# This mode is used for AP testing special operation
elif mode == 'SRI0913_MOGA':
    ETAX = 1.0
    ETAY = 1.0

